{
  "name": "the-meadow",
  "private": true,
  "version": "0.0.0",
  "description": "An interactive, parametric tiny planet: a growable alpine meadow in a painted style.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:single": "tsc -p tsconfig.json && vite build --mode single",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && eslint .",
    "test": "vitest run",
    "test:gpu": "playwright test --project=invariants",
    "shots": "playwright test --project=shots",
    "squint": "playwright test --project=squint",
    "verify": "npm run check && npm test && npm run test:gpu && npm run shots",
    "sim": "tsx --no-warnings server/cli/sim.ts",
    "serve": "tsx --no-warnings server/http.ts",
    "record:media": "tsx --no-warnings server/cli/record-media.ts",
    "new-environment": "node --experimental-strip-types scripts/new-environment.ts",
    "dev:lantern": "vite --port 5225 --strictPort",
    "build:lantern": "tsc -p tsconfig.json && vite build --config environments/lantern-reed-gardens/vite.config.ts",
    "dev:scarlet": "vite --port 5227 --strictPort",
    "build:scarlet": "tsc -p environments/scarlet-sail-canyon/tsconfig.json && vite build --config environments/scarlet-sail-canyon/vite.config.ts",
    "check:scarlet": "tsc -p environments/scarlet-sail-canyon/tsconfig.json && eslint environments/scarlet-sail-canyon",
    "dev:ukiyoe": "vite --port 5237 --strictPort",
    "check:ukiyoe": "tsc -p environments/ukiyoe-pine-hamlet/tsconfig.json && eslint environments/ukiyoe-pine-hamlet",
    "build:ukiyoe": "tsc -p environments/ukiyoe-pine-hamlet/tsconfig.json && vite build --config environments/ukiyoe-pine-hamlet/vite.config.ts"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.184.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}

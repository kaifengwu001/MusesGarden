{
  "name": "the-meadow",
  "private": true,
  "version": "0.0.0",
  "description": "An interactive, parametric tiny planet: a growable alpine meadow in a painted style.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:single": "tsc -p tsconfig.json && vite build --mode single",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && eslint .",
    "test": "vitest run",
    "test:gpu": "playwright test --project=invariants",
    "shots": "playwright test --project=shots",
    "squint": "playwright test --project=squint",
    "squint:terraces": "playwright test --project=squint-terraces",
    "verify": "npm run check && npm test && npm run test:gpu && npm run shots"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.184.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}

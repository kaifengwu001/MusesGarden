{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.live.config.ts",
    "playwright.visit.config.ts",
    "src/dev/**/*.spec.ts",
    "src/muse/ui/**/*.e2e.ts",
    "src/visit/**/*.spec.ts",
    "src/dev/harnessApi.ts",
    "environments/**/*.spec.ts",
    "environments/*/vite.config.ts",
    "scripts/*.ts"
  ]
}
